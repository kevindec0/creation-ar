# Copia este archivo como .env para desarrollo local. Todas las variables son opcionales.
# En Vercel NO hace falta este archivo: las variables se configuran en el panel del proyecto.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# URL pública de la app, para los códigos QR. Si falta, se usa la dirección de cada petición.
# APP_URL=https://tu-proyecto.vercel.app

# Permite que cualquiera cree una cuenta de artista
ALLOW_REGISTRATION=true

# --- Base de datos ---
# Sin DATABASE_URL se usa PGlite (Postgres embebido) guardado en DATA_DIR/db.
# Para usar tu base de Neon también en local, pega aquí su cadena de conexión:
# DATABASE_URL=postgres://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATA_DIR=./data

# --- Archivos subidos ---
# Sin BLOB_READ_WRITE_TOKEN los archivos se guardan en DATA_DIR/uploads.
# Con el token de tu Blob store de Vercel, se suben a Vercel Blob (como en producción).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
MAX_UPLOAD_MB=50

# Alternativa a Vercel Blob para otros hostings: Cloudflare R2, Backblaze B2, MinIO o S3
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=creationar
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Detrás de un proxy o túnel propio (en Vercel se activa solo)
# TRUST_PROXY=true
